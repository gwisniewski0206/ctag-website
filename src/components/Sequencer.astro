---
// Gezeichneter Drumcomputer mit 16 Schritten. Beim Scrollen wandert das Lauflicht (ohne Ton),
// Felder lassen sich an- und ausschalten, "Play" spielt das Muster mit im Browser erzeugten Klängen (src/lib/sequencer.ts).
const tracks = [
  { name: 'Kick', color: 'var(--amber)', steps: [0, 4, 8, 12, 14] },
  { name: 'Snare', color: 'var(--red)', steps: [4, 12] },
  { name: 'Hat', color: 'var(--sky)', steps: [0, 2, 4, 6, 8, 10, 11, 12, 14] },
  { name: 'Clap', color: '#fff', steps: [7, 15] },
];
---
<section class="seq" data-sequencer aria-label="Spielbarer Step-Sequencer">
  <div class="seq-head">
    <span class="seq-tag">Pattern 01</span>
    <p>Scrollen bewegt das Lauflicht. Felder antippen, dann <strong>Play</strong>.</p>
    <button type="button" class="seq-play" aria-pressed="false">
      <svg width="18" height="18" viewBox="0 0 18 18" aria-hidden="true"><path class="seq-play-icon" d="M4 2 L16 9 L4 16 Z" fill="currentColor"></path></svg>
      <span>Play</span>
    </button>
  </div>
  <div class="seq-grid">
    {tracks.map((t, row) => (
      <div class="seq-row" style={`--pad: ${t.color}`}>
        <span class="seq-label">{t.name}</span>
        {Array.from({ length: 16 }, (_, i) => (
          <button type="button" class="seq-pad" data-row={row} data-step={i} aria-pressed={t.steps.includes(i) ? 'true' : 'false'}
            aria-label={`${t.name}, Schritt ${i + 1}`}></button>
        ))}
      </div>
    ))}
    <div class="seq-row seq-leds" aria-hidden="true">
      <span class="seq-label"></span>
      {Array.from({ length: 16 }, (_, i) => <span class:list={['seq-led', { beat: i % 4 === 0 }]} data-step={i}></span>)}
    </div>
  </div>
</section>

<script>
  import '../lib/sequencer';
</script>

<style>
  .seq {
    background: var(--blue); color: #fff; border: var(--line); border-radius: var(--r-card);
    padding: clamp(20px, 3vw, 36px); display: flex; flex-direction: column; gap: 22px;
  }
  .seq-head { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 20px; }
  .seq-head p { flex: 1 1 260px; margin: 0; font-size: 17px; }
  .seq-tag {
    font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: 22px;
    padding: 2px 14px; background: var(--amber); color: var(--blue); border-radius: var(--r-tag);
  }
  .seq-play {
    display: inline-flex; align-items: center; gap: 10px; min-height: 48px; padding: 0 22px;
    font: inherit; font-weight: 700; font-size: 18px; cursor: pointer;
    background: var(--red); color: #fff; border: 2px solid #fff; border-radius: var(--r-tag);
  }
  .seq-play[aria-pressed='true'] { background: var(--amber); color: var(--blue); }
  .seq-grid { display: flex; flex-direction: column; gap: 8px; }
  .seq-row { display: grid; grid-template-columns: 64px repeat(16, minmax(0, 1fr)); gap: 6px; align-items: center; }
  .seq-label { font-weight: 700; font-size: 15px; }
  .seq-pad {
    aspect-ratio: 1; min-width: 0; padding: 0; cursor: pointer;
    background: var(--mid); border: 2px solid var(--blue); border-radius: var(--r-tag);
    transition: transform 80ms ease-out;
  }
  /* Jede vierte Spalte etwas abgesetzt, wie auf echten Geräten */
  .seq-pad:nth-child(4n + 2) { box-shadow: inset 0 0 0 2px rgba(255, 255, 255, 0.18); }
  .seq-pad[aria-pressed='true'] { background: var(--pad); }
  .seq-pad.now { border-color: #fff; }
  .seq-pad.now[aria-pressed='true'] { transform: scale(1.12); }
  .seq-leds { margin-top: 4px; }
  .seq-led { justify-self: center; width: 10px; height: 10px; border-radius: 50%; background: var(--mid); }
  .seq-led.beat { background: #6f8fbf; }
  .seq-led.now { background: var(--amber); box-shadow: 0 0 0 3px rgba(245, 183, 0, 0.35); }
  @media (max-width: 640px) {
    .seq-row { grid-template-columns: repeat(16, minmax(0, 1fr)); gap: 3px; }
    .seq-label { grid-column: 1 / -1; font-size: 13px; }
    .seq-leds .seq-label { display: none; }
    .seq-pad { border-width: 1px; border-radius: 3px; }
  }
</style>
