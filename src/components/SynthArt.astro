<style>
  .synth { overflow: visible; touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .synth :global(.cable), .synth :global(.plug) { cursor: grab; }
  .synth :global(.knob), .synth :global(.fader), .synth :global(.fader-track) { cursor: ns-resize; }
  /* Angehobenes Kabel: liegt vorn und wirft einen Schatten */
  .synth :global(.cable) { transition: filter 120ms; }
  .synth :global(.cable.lifted) { filter: drop-shadow(0 10px 6px rgba(0, 20, 40, 0.45)); }
  .synth:global(.dragging), .synth:global(.dragging) :global(*) { cursor: grabbing; }
</style>
