---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
import PlaySynth from '../components/PlaySynth.astro';
import Playground from '../components/Playground.astro';

const partners = (await getCollection('partners')).sort((a, b) => a.data.order - b.data.order);
const backgrounds = ['var(--amber)', '#fff', 'var(--sky)', '#fff'];
// Der Synth steht nach der zweiten Reihe (bei 4 Spalten) – bei 2 Spalten nach der vierten
const SYNTH_AFTER = 8;
const domain = (url) => new URL(url).hostname.replace(/^www\./, '');
---
<Base title="Partners">
  <PageHero title="Partners" color="red" />
  <main class="partners-main">
    <div class="wrap partners-part">
      <div class="grid partners-grid">
        {partners.slice(0, SYNTH_AFTER).map(({ data: p }, j) => {
          const i = j;
          return (
        <a href={p.url} class="card-link partner" style={`background: ${backgrounds[i % 4]}`}>
          {p.logo && <span class="partner-logo"><img src={p.logo} alt="" loading="lazy"></span>}
          <span class="partner-name">{p.name}</span>
          <span class="partner-foot">
            <span>{p.label ?? domain(p.url)}</span>
            <Arrow />
          </span>
        </a>
          );
        })}
      </div>
    </div>

    <Playground><PlaySynth /></Playground>

    <div class="wrap partners-part">
      <div class="grid partners-grid">
        {partners.slice(SYNTH_AFTER).map(({ data: p }, j) => {
          const i = SYNTH_AFTER + j;
          return (
        <a href={p.url} class="card-link partner" style={`background: ${backgrounds[i % 4]}`}>
          {p.logo && <span class="partner-logo"><img src={p.logo} alt="" loading="lazy"></span>}
          <span class="partner-name">{p.name}</span>
          <span class="partner-foot">
            <span>{p.label ?? domain(p.url)}</span>
            <Arrow />
          </span>
        </a>
          );
        })}
      </div>
    </div>
  </main>
</Base>

<style>
  .partners-part { padding-top: 48px; padding-bottom: 48px; }
  .partners-part:last-child { padding-bottom: 80px; }
  .partners-grid { grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); }
  .partner { padding: 20px; }
  .partner:hover { outline: 4px solid var(--blue); outline-offset: -6px; background: inherit; }
  .partner-logo { display: flex; align-items: center; justify-content: center; height: 120px; padding: 14px; background: #fff; border: var(--line); border-radius: var(--r-tag); }
  .partner-logo img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .partner-name { font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: 20px; line-height: 1.15; color: var(--blue); overflow-wrap: break-word; }
  .partner-foot { display: flex; align-items: center; justify-content: space-between; gap: 12px; font-weight: 700; font-size: 16px; color: var(--blue); }
  .partner-foot span { min-width: 0; overflow-wrap: anywhere; }
</style>
