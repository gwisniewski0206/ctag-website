---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import Arrow from '../components/Arrow.astro';
---
<Base title="Contact">
  <PageHero title="Contact" color="amber" />
  <main class="wrap contact-main">
    <a href="/impressum/" class="contact-card bg-sky"><span class="display">Impressum</span><Arrow size={36} /></a>
    <a href="/datenschutzerklarung/" class="contact-card bg-red"><span class="display">Datenschutz&shy;erklärung</span><Arrow size={36} /></a>
  </main>
</Base>

<style>
  .contact-main { padding-top: 56px; padding-bottom: 88px; display: flex; flex-wrap: wrap; gap: 28px; }
  .contact-card {
    flex: 1 1 320px; min-width: 0; min-height: 200px; padding: 28px;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px;
    border: var(--line); border-radius: var(--r-card); text-decoration: none; color: var(--blue);
  }
  .contact-card:hover { color: var(--blue); outline: 4px solid var(--blue); outline-offset: -6px; }
  .contact-card .display { font-size: clamp(26px, 3.4vw, 44px); line-height: 1; overflow-wrap: anywhere; }
</style>
