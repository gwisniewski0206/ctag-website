---
import { getEntry } from 'astro:content';
import Base from '../layouts/Base.astro';
import SynthArt from '../components/SynthArt.astro';
import Waves from '../components/Waves.astro';
import legacyIds from '../lib/legacy-ids.json';

const home = (await getEntry('home', 'home')).data;
const cardIcons = [
  '<svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#F5B700"></rect><path d="M8 32 q8 -28 16 0 t16 0 t16 0" fill="none" stroke="#00305D" stroke-width="5" stroke-linecap="round"></path></svg>',
  '<svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#DCE8F5"></rect><circle cx="23" cy="27" r="10" fill="#FFFFFF" stroke="#00305D" stroke-width="4"></circle><circle cx="41" cy="27" r="10" fill="#F5B700" stroke="#00305D" stroke-width="4"></circle><circle cx="32" cy="41" r="10" fill="#E8452C" stroke="#00305D" stroke-width="4"></circle></svg>',
  '<svg width="64" height="64" viewBox="0 0 64 64" aria-hidden="true"><rect width="64" height="64" rx="16" fill="#E8452C"></rect><circle cx="32" cy="32" r="18" fill="#00305D"></circle><line x1="32" y1="32" x2="42" y2="20" stroke="#FFFFFF" stroke-width="5" stroke-linecap="round"></line></svg>',
];
---
<Base description={home.introDe}>
  <script slot="head" is:inline define:vars={{ legacyIds, base: import.meta.env.BASE_URL.replace(/\/$/, '') }}>
    // Alte Adressen der Form /?p=128 oder /?page_id=128 auf die neue Seite umleiten
    (function () {
      var q = new URLSearchParams(location.search);
      var id = q.get('p') || q.get('page_id');
      if (id && legacyIds[id]) location.replace(base + legacyIds[id]);
    })();
  </script>

  <section class="home-hero">
    <div class="home-hero-text bg-amber">
      <span class="tag">Arbeitsgruppe an der HAW Kiel</span>
      <h1 class="display home-title">Creative<br>Technologies</h1>
      <span class="home-badge">(CTAG)</span>
    </div>
    <div class="home-hero-art"><SynthArt /></div>
  </section>

  <main class="wrap home-main">
    <section class="home-intro">
      <p class="home-lead">{home.introDe}</p>
      <aside lang="en" class="home-en">
        <span class="home-en-tag">EN</span>
        <p>{home.introEn}</p>
      </aside>
    </section>

    <section class="home-cards">
      {home.cards.map((c, i) => (
        <article class="home-card">
          <Fragment set:html={cardIcons[i % cardIcons.length]} />
          <h2 class="display">{c.title}</h2>
          <p>{c.text}</p>
        </article>
      ))}
    </section>

    <section class="home-highlight">
      <svg width="88" height="88" viewBox="0 0 88 88" aria-hidden="true"><path d="M44 6 L54 32 L82 34 L60 51 L68 78 L44 62 L20 78 L28 51 L6 34 L34 32 Z" fill="#F5B700" stroke="#00305D" stroke-width="5" stroke-linejoin="round"></path></svg>
      <p>{home.highlight}</p>
    </section>
  </main>

  <section class="home-motto">
    <div class="wrap">
      <div class="home-motto-text">
        <span class="home-motto-tag">Unser Motto:</span>
        <h2 class="display">{home.motto}</h2>
      </div>
      <Waves class="home-motto-art" />
    </div>
  </section>
</Base>

<style>
  .home-hero { display: flex; flex-wrap: wrap; border-bottom: var(--line); }
  .home-hero-text {
    flex: 3 1 420px; min-width: 0;
    padding: clamp(32px, 6vw, 88px) clamp(24px, 4vw, 56px) clamp(32px, 6vw, 88px) max(24px, calc(50vw - 596px));
    display: flex; flex-direction: column; justify-content: center; gap: 22px; align-items: flex-start;
  }
  .home-title { font-size: clamp(34px, 5.2vw, 76px); line-height: 0.98; letter-spacing: -0.02em; }
  .home-badge {
    display: inline-block; padding: 4px 22px; background: var(--red); border: var(--line); border-radius: var(--r-tag);
    font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: clamp(24px, 3vw, 40px); color: var(--blue);
  }
  .home-hero-art { flex: 2 1 380px; min-width: 0; background: var(--blue); padding: clamp(20px, 3vw, 40px); display: flex; align-items: center; }
  .home-hero-art :global(.synth) { width: 100%; height: auto; display: block; }

  .home-main { padding-top: clamp(40px, 6vw, 80px); padding-bottom: clamp(40px, 6vw, 80px); display: flex; flex-direction: column; gap: clamp(32px, 5vw, 64px); }
  .home-intro { display: flex; flex-wrap: wrap; gap: 32px 48px; align-items: flex-start; }
  .home-lead { flex: 3 1 420px; min-width: 0; margin: 0; font-size: clamp(22px, 2.4vw, 30px); font-weight: 700; line-height: 1.3; color: var(--blue); }
  .home-en { flex: 2 1 320px; min-width: 0; padding: 24px; background: var(--sky); border: var(--line); border-radius: var(--r-card); display: flex; flex-direction: column; gap: 10px; }
  .home-en-tag { align-self: flex-start; padding: 2px 12px; background: var(--blue); color: #fff; border-radius: var(--r-tag); font-weight: 700; font-size: 14px; }
  .home-en p { margin: 0; font-size: 17px; font-weight: 600; line-height: 1.5; }

  .home-cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px; }
  .home-card { padding: 24px; background: #fff; border: var(--line); border-radius: var(--r-card); display: flex; flex-direction: column; gap: 14px; }
  .home-card h2 { font-size: 24px; line-height: 1.1; }
  .home-card p { margin: 0; }

  .home-highlight { padding: clamp(24px, 4vw, 44px); background: var(--red); border: var(--line); border-radius: var(--r-card); display: flex; flex-wrap: wrap; align-items: center; gap: 20px 32px; }
  .home-highlight svg { flex: 0 0 88px; }
  .home-highlight p { flex: 1 1 360px; min-width: 0; margin: 0; font-size: clamp(20px, 2.2vw, 26px); font-weight: 700; line-height: 1.35; color: #fff; }

  .home-motto { background: var(--blue); color: var(--amber); }
  .home-motto .wrap { padding-top: clamp(40px, 7vw, 96px); padding-bottom: clamp(40px, 7vw, 96px); display: flex; flex-wrap: wrap; align-items: center; gap: 32px 56px; }
  .home-motto-text { flex: 3 1 420px; min-width: 0; display: flex; flex-direction: column; align-items: flex-start; gap: 20px; }
  .home-motto-tag { padding: 4px 16px; background: #fff; color: var(--blue); border-radius: var(--r-tag); font-weight: 700; }
  .home-motto h2 { color: var(--amber); font-size: clamp(28px, 4.4vw, 60px); line-height: 1.04; letter-spacing: -0.02em; }
  .home-motto :global(.home-motto-art) { flex: 2 1 280px; min-width: 0; height: auto; }
</style>
