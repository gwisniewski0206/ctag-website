---
import { getCollection, getEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Arrow from '../../components/Arrow.astro';
import Sequencer from '../../components/Sequencer.astro';
import Playground from '../../components/Playground.astro';

const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
const page = (await getEntry('projectsPage', 'projects')).data;
const accents = ['var(--amber)', 'var(--blue)', 'var(--red)'];
// Der Sequencer steht zwischen zwei Hälften der Liste; geteilt auf ein Vielfaches von 12, damit bei 2, 3 und 4 Spalten keine Reihe halb leer bleibt
const half = Math.ceil(projects.length / 2 / 12) * 12;
const halves = [projects.slice(0, half), projects.slice(half)];
---
<Base title="Projects">
  <PageHero title="Projects" color="sky" />
  <main class="projects-main">
    <div class="wrap projects-part">
      <div class="filter">
        <label for="q">Filter projects (<span id="q-count">{projects.length}</span> of {projects.length})</label>
        <input id="q" type="search" placeholder="e.g. Eurorack, JUCE, Space Game" autocomplete="off">
      </div>
    <div class="grid projects-grid">
      {halves[0].map((p, j) => {
        const i = j;
        return (
              <a href={`/projects/${p.id}/`} class="card-link" style={`box-shadow: inset 0 8px 0 ${accents[i % 3]}; padding-top: 26px`} data-title={p.data.title.toLowerCase()}>
                <span class="card-top">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <Arrow />
                </span>
                <span class="card-title">{p.data.title}</span>
              </a>
        );
      })}
    </div>
    </div>

    <Playground><Sequencer /></Playground>

    <div class="wrap projects-part">
    <div class="grid projects-grid">
      {halves[1].map((p, j) => {
        const i = half + j;
        return (
              <a href={`/projects/${p.id}/`} class="card-link" style={`box-shadow: inset 0 8px 0 ${accents[i % 3]}; padding-top: 26px`} data-title={p.data.title.toLowerCase()}>
                <span class="card-top">
                  <span class="num">{String(i + 1).padStart(2, '0')}</span>
                  <Arrow />
                </span>
                <span class="card-title">{p.data.title}</span>
              </a>
        );
      })}
    </div>
      <p id="q-empty" hidden>Kein Projekt passt zu diesem Filter.</p>

      <section class="opportunities">
        <h2 class="display">{page.opportunitiesTitle}</h2>
        <ul>
          {page.opportunities.map((o) => <li>{o}</li>)}
          <li class="cta">{page.opportunitiesCta}</li>
        </ul>
      </section>
    </div>
  </main>
</Base>

<script>
  const input = document.getElementById('q') as HTMLInputElement;
  const cards = [...document.querySelectorAll<HTMLElement>('.projects-grid > a')];
  const count = document.getElementById('q-count')!;
  const empty = document.getElementById('q-empty')!;
  input.addEventListener('input', () => {
    const words = input.value.toLowerCase().split(/\s+/).filter(Boolean);
    let n = 0;
    for (const c of cards) {
      const hit = words.every((w) => c.dataset.title!.includes(w));
      c.hidden = !hit;
      if (hit) n++;
    }
    count.textContent = String(n);
    empty.hidden = n > 0;
  });
</script>

<style>
  .projects-part { padding-top: 40px; padding-bottom: 48px; display: flex; flex-direction: column; gap: 32px; }
  .projects-part:last-child { padding-top: 48px; padding-bottom: 80px; }
  .filter { display: flex; flex-direction: column; gap: 6px; max-width: 420px; }
  .filter label { font-weight: 700; color: var(--blue); }
  .filter input {
    height: 52px; padding: 0 20px; width: 100%; background: #fff; color: var(--ink);
    border: var(--line); border-radius: var(--r-tag); font-family: inherit; font-size: 17px;
  }
  .projects-grid { grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); }
  .projects-grid [hidden] { display: none; }
  .opportunities { margin-top: 24px; padding: clamp(24px, 4vw, 44px); background: var(--amber); border: var(--line); border-radius: var(--r-card); display: flex; flex-direction: column; gap: 20px; }
  .opportunities h2 { font-size: clamp(28px, 4vw, 48px); line-height: 1; }
  .opportunities ul { margin: 0; padding: 0; list-style: none; display: flex; flex-wrap: wrap; gap: 12px; }
  .opportunities li { padding: 10px 20px; background: #fff; border: var(--line); border-radius: var(--r-tag); font-weight: 700; color: var(--blue); }
  .opportunities li.cta { background: var(--red); color: #fff; font-size: 20px; }
</style>
