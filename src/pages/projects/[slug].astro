---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';

export async function getStaticPaths() {
  const projects = (await getCollection('projects', (p) => !p.data.draft)).sort((a, b) => a.data.order - b.data.order);
  return projects.map((project, i) => ({
    params: { slug: project.id },
    props: { project, number: i + 1, prev: projects[i - 1], next: projects[i + 1] },
  }));
}

const { project, number, prev, next } = Astro.props;
const { Content, headings } = await render(project);
const d = project.data;

// Inhaltsverzeichnis: die beiden obersten Überschriftsebenen, die im Beitrag vorkommen
// (alte Beiträge fangen mal bei ##, mal bei ### an). Ab zwei Einträgen anzeigen.
const top = Math.min(...headings.map((h) => h.depth));
const toc = headings.filter((h) => h.depth <= top + 1).map((h) => ({ ...h, sub: h.depth > top }));
const showToc = toc.length >= 2;
const when = d.semester ?? (d.year ? String(d.year) : undefined);
const hasFacts = when || d.team.length || d.supervisor || d.links.length || d.tags.length;
---
<Base title={d.title} description={d.summary}>
  <PageHero title={d.title} color="sky">
    <Fragment slot="meta">
      <span class="tag">Projekt {String(number).padStart(2, '0')}</span>
      {when && <span class="tag">{when}</span>}
    </Fragment>
  </PageHero>

  <main class="wrap project-main">
    <div class:list={['project-layout', { 'no-side': !showToc && !hasFacts }]}>
      {(showToc || hasFacts) && (
        <aside class="project-side" aria-label="Projektinfos und Inhalt">
          {hasFacts && (
            <dl class="facts">
              {when && <><dt>Zeitraum</dt><dd>{when}</dd></>}
              {d.team.length > 0 && <><dt>Team</dt><dd>{d.team.join(', ')}</dd></>}
              {d.supervisor && <><dt>Betreuung</dt><dd>{d.supervisor}</dd></>}
              {d.tags.length > 0 && <><dt>Themen</dt><dd class="facts-tags">{d.tags.map((t) => <span>{t}</span>)}</dd></>}
              {d.links.length > 0 && <><dt>Links</dt><dd><ul class="facts-links">{d.links.map((l) => <li><a href={l.url}>{l.label}</a></li>)}</ul></dd></>}
            </dl>
          )}
          {showToc && (
            <details class="toc" open data-toc>
              <summary>Auf dieser Seite</summary>
              <ol>
                {toc.map((h) => <li class:list={{ sub: h.sub }}><a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a></li>)}
              </ol>
            </details>
          )}
        </aside>
      )}

      <div class="project-content">
        {d.summary && <p class="summary">{d.summary}</p>}
        {d.demo && (
          <section class="demo">
            <iframe class="demo-frame" src={d.demo} title={`Interaktive Demo: ${d.title}`} loading="lazy"></iframe>
            <p><a href={d.demo}>Demo im eigenen Fenster öffnen</a></p>
          </section>
        )}
        <article class="prose">
          <Content />
        </article>
      </div>
    </div>

    <nav class="pager" aria-label="Weitere Projekte">
      {prev ? <a href={`/projects/${prev.id}/`} class="pager-link"><span>← Vorheriges</span>{prev.data.title}</a> : <span />}
      <a href="/projects/" class="pager-all">Alle Projekte</a>
      {next ? <a href={`/projects/${next.id}/`} class="pager-link next"><span>Nächstes →</span>{next.data.title}</a> : <span />}
    </nav>
  </main>
</Base>

<script>
  // Aktuellen Abschnitt im Inhaltsverzeichnis hervorheben; auf schmalen Bildschirmen ist das Verzeichnis zugeklappt
  const toc = document.querySelector<HTMLDetailsElement>('[data-toc]');
  if (toc) {
    const narrow = window.matchMedia('(max-width: 960px)');
    const sync = () => { toc.open = !narrow.matches; };
    sync();
    narrow.addEventListener('change', sync);
    const links = new Map([...toc.querySelectorAll<HTMLAnchorElement>('[data-toc-link]')].map((a) => [a.dataset.tocLink!, a]));
    const targets = [...links.keys()].map((id) => document.getElementById(id)).filter(Boolean) as HTMLElement[];
    let current = '';
    const update = () => {
      // Der letzte Abschnitt, dessen Überschrift schon über dem oberen Drittel liegt
      let id = targets[0]?.id ?? '';
      for (const t of targets) if (t.getBoundingClientRect().top < innerHeight * 0.3) id = t.id;
      if (id === current) return;
      links.get(current)?.removeAttribute('aria-current');
      links.get(id)?.setAttribute('aria-current', 'true');
      current = id;
    };
    addEventListener('scroll', update, { passive: true });
    update();
  }
</script>

<style>
  .project-main { padding-top: clamp(32px, 5vw, 56px); padding-bottom: 80px; display: flex; flex-direction: column; gap: 40px; }
  .project-layout { display: grid; grid-template-columns: minmax(0, 1fr) 280px; gap: 48px; align-items: start; }
  .project-layout.no-side { grid-template-columns: minmax(0, 1fr); }
  .project-content { grid-column: 1; grid-row: 1; min-width: 0; display: flex; flex-direction: column; gap: 32px; }
  .project-side { grid-column: 2; grid-row: 1; position: sticky; top: 24px; max-height: calc(100vh - 48px); overflow-y: auto; display: flex; flex-direction: column; gap: 20px; }
  .summary { margin: 0; max-width: 820px; font-size: clamp(20px, 2vw, 24px); font-weight: 700; line-height: 1.35; color: var(--blue); }

  .facts { margin: 0; padding: 18px 20px; background: var(--sky); border: var(--line); border-radius: var(--r-card); display: grid; gap: 4px 0; }
  .facts dt { font-size: 13px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mid); margin-top: 8px; }
  .facts dt:first-child { margin-top: 0; }
  .facts dd { margin: 0; font-weight: 600; color: var(--blue); }
  .facts-tags { display: flex; flex-wrap: wrap; gap: 6px; }
  .facts-tags span { padding: 1px 10px; border: 2px solid var(--blue); border-radius: var(--r-tag); background: #fff; font-size: 14px; }
  .facts-links { margin: 0; padding: 0; list-style: none; }

  .toc { border: var(--line); border-radius: var(--r-card); padding: 14px 18px 16px; background: #fff; }
  .toc summary { cursor: pointer; font-family: var(--display); font-weight: 800; font-stretch: 125%; font-size: 15px; text-transform: uppercase; letter-spacing: 0.04em; color: var(--blue); }
  .toc ol { list-style: none; margin: 12px 0 0; padding: 0; display: flex; flex-direction: column; gap: 2px; }
  .toc a { display: block; padding: 5px 10px; border-left: 3px solid transparent; border-radius: 0 var(--r-tag) var(--r-tag) 0; text-decoration: none; font-size: 15px; font-weight: 600; line-height: 1.3; color: var(--ink); }
  .toc .sub a { padding-left: 24px; font-weight: 400; font-size: 14px; }
  .toc a:hover { background: var(--sky); color: var(--blue); }
  .toc a[aria-current] { border-left-color: var(--amber); background: var(--sky); color: var(--blue); }
  /* Sprungziele nicht unter die Fensterkante legen */
  .prose :global(h1), .prose :global(h2), .prose :global(h3), .prose :global(h4) { scroll-margin-top: 24px; }

  .demo { max-width: 1024px; }
  .demo .demo-frame { aspect-ratio: 4 / 3; }
  .demo p { margin: 8px 0 0; font-size: 16px; }
  .pager { display: grid; grid-template-columns: 1fr auto 1fr; gap: 16px; align-items: stretch; border-top: var(--line); padding-top: 32px; }
  .pager-link { display: flex; flex-direction: column; gap: 4px; padding: 16px; border: var(--line); border-radius: var(--r-card); text-decoration: none; font-weight: 700; line-height: 1.25; overflow-wrap: anywhere; }
  .pager-link span { font-size: 15px; font-weight: 600; }
  .pager-link.next { text-align: right; }
  .pager-link:hover { background: var(--sky); color: var(--blue); }
  .pager-all { align-self: center; padding: 11px 16px; border-radius: var(--r-tag); background: var(--blue); color: #fff; font-weight: 700; text-decoration: none; }
  .pager-all:hover { color: #fff; background: var(--mid); }

  @media (max-width: 960px) {
    .project-layout { grid-template-columns: minmax(0, 1fr); gap: 24px; }
    .project-side { grid-column: 1; grid-row: 1; position: static; max-height: none; overflow: visible; }
    .project-content { grid-row: 2; }
  }
  @media (max-width: 640px) {
    .pager { grid-template-columns: 1fr; }
    .pager-link.next { text-align: left; }
    .pager-all { justify-self: start; }
  }
</style>
